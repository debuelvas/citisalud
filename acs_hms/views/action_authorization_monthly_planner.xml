<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Acción del Planificador -->
    <record id="action_authorization_monthly_planner" model="ir.actions.act_window">
        <field name="name">Planificador de Autorizaciones</field>
        <field name="res_model">authorization.monthly.planner</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Cree y programe autorizaciones mensuales
            </p>
        </field>
    </record>

    <!-- Vista Form del Planificador -->
    <record id="view_authorization_monthly_planner_form" model="ir.ui.view">
        <field name="name">authorization.monthly.planner.form</field>
        <field name="model">authorization.monthly.planner</field>
        <field name="arch" type="xml">
            <form string="Planificador de Autorizaciones">
                <sheet>
                   <label for="return_date" string="Rango de fecha"/>
                    <div name="Rango de fecha">
                        <field name="target_month" class="oe_inline"/> - <field name="return_date" class="oe_inline"/>
                    </div>
                    <group>
                        <group>
                            <field name="insurance_id" options="{'no_create': True}"/>
                            <field name="contract_id" options="{'no_create': True}"/>
                        </group>
                        <group>
                            <field name="department_id" options="{'no_create': True}"/>
                          
                        </group>
                    </group>
                    <notebook>
                        <page string="Autorizaciones a Programar" name="authorizations">
                            <field name="authorization_ids" 
                                   options="{'no_create': True}">
                                <tree>
                                    <field name="name"/>
                                    <field name="patient_id"/>
                                    <field name="insurance_id"/>
                                    <field name="contract_id"/>
                                    <field name="service_type"/>
                                    <field name="start_date"/>
                                    <field name="end_date"/>
                                    <field name="state"/>
                                </tree>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <footer>
                    <button name="action_create_authorizations" 
                            string="Crear Autorizaciones" 
                            type="object" 
                            class="btn-primary" 
                            data-hotkey="q"/>
                    <button special="cancel" 
                            string="Cancelar" 
                            class="btn-secondary" 
                            data-hotkey="z"/>
                </footer>
            </form>
        </field>
    </record>

    <!-- Menú del Planificador -->


</odoo>